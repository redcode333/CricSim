# Copy this file to .env and fill in your real values. .env itself is
# gitignored — never commit real credentials.

# Neon Postgres connection string (Neon dashboard -> your project -> Connect)
DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/dbname?sslmode=require

# Optional: Google OAuth (leave blank to disable "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5174
